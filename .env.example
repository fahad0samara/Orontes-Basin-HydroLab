# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional GIS Basemap Tile Server URL Overrides (Client-Side)
NEXT_PUBLIC_GIS_TILE_SATELLITE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_GIS_TILE_SHADED_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_GIS_TILE_TOPO_URL="https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_GIS_TILE_DARK_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_GIS_TILE_OSM_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Optional External Pre-Computed Raster Layer URL Template or GeoServer WMS Endpoint
# Example: "https://geoserver.example.org/orontes/rasters/{layerId}.png"
NEXT_PUBLIC_ORONTES_RASTER_ASSET_TEMPLATE_URL=""
